# Host ports published by docker-compose.yml
WEB_PORT=3000
API_PORT=3001
POSTGRES_PORT=5432
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001

# PostgreSQL role and database created when the postgres volume is first initialised
POSTGRES_USER=helpmegethired
POSTGRES_PASSWORD=helpmegethired
POSTGRES_DB=helpmegethired

# Credentials the object store is started with and the API signs with; development-only values, unique per environment
S3_ACCESS_KEY=helpmegethired
S3_SECRET_KEY=helpmegethired-storage
# Bucket the init service creates for Uploaded Resumes, private with CORS for the web origin
S3_BUCKET=resumes
S3_REGION=us-east-1
# Seconds a presigned upload URL stays valid
PRESIGN_EXPIRES_SECONDS=300

# Secret that signs the Auth.js cookies in the web app; at least 32 characters, unique per environment
AUTH_SECRET=development-only-secret-replace-me-before-deploying

# Resend API key for the one-time code email; leave blank locally and the web service prints the code instead of sending it
AUTH_RESEND_KEY=
# Sender of the one-time code email, on a domain verified in Resend; required whenever AUTH_RESEND_KEY is set
EMAIL_FROM=
