<mxfile host="app.diagrams.net" modified="2026-09-17T00:00:00.000Z" agent="helpmegethired" version="24.7.0">
  <diagram id="job-analysis-pipeline" name="Job analysis pipeline">
    <mxGraphModel dx="2000" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="&lt;b&gt;Help Me Get Hired · Job Analysis pipeline (Paste Job Description + AI operations)&lt;/b&gt;&lt;br&gt;Sequential Agents (ADR-0009, TC-06), RAG before every Agent (TC-07), one active analysis per Candidate (TC-05). Superseded parts of the original idea: parallel agents, response validation with undefined fields, reconciliation job, embedding of agent output." style="text;html=1;align=left;verticalAlign=top;fontSize=13;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1300" height="40" as="geometry"/>
        </mxCell>

        <!-- ===================== FRONTEND ===================== -->
        <mxCell id="ctFront" value="Frontend (Next.js, apps/web)" style="swimlane;html=1;fontStyle=1;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="360" height="270" as="geometry"/>
        </mxCell>
        <mxCell id="A1" value="Candidate pastes a Job Description" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="ctFront">
          <mxGeometry x="20" y="45" width="320" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="A2" value="POST /analyses { jobDescription }&lt;br&gt;body typed by &lt;i&gt;startAnalysisRequestSchema&lt;/i&gt; (packages/shared)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="ctFront">
          <mxGeometry x="20" y="110" width="320" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="A3" value="Polls GET /analyses/:runId&lt;br&gt;Renders one Step per AnalysisAgent from its persisted status (pending · running · completed · failed · skipped) and shows failure_reason when the run failed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="ctFront">
          <mxGeometry x="20" y="185" width="320" height="70" as="geometry"/>
        </mxCell>

        <!-- ===================== API ===================== -->
        <mxCell id="ctApi" value="API (NestJS, apps/api) · analysis module" style="swimlane;html=1;fontStyle=1;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="60" width="540" height="620" as="geometry"/>
        </mxCell>
        <mxCell id="B1" value="AnalysisController&lt;br&gt;Validates the body with the shared Zod schema, resolves the Candidate from the Session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="ctApi">
          <mxGeometry x="20" y="40" width="500" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="B2" value="AnalysisService.start(candidateId, jobDescription)&lt;br&gt;Runs inside one transaction (Kysely)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="ctApi">
          <mxGeometry x="20" y="105" width="500" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="B3" value="Active run for this Candidate?&lt;br&gt;(status in queued, running)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="ctApi">
          <mxGeometry x="140" y="170" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="B4" value="Lease alive?&lt;br&gt;heartbeat_at newer than N minutes&lt;br&gt;(N &amp;gt; worst Agent time incl. backoff)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="ctApi">
          <mxGeometry x="140" y="280" width="260" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="B5" value="409 Conflict&lt;br&gt;analysis already in progress&lt;br&gt;returns the active runId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="ctApi">
          <mxGeometry x="20" y="400" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="B6" value="Orphan run (worker died, Redis lost the job)&lt;br&gt;Mark run failed, failure_reason = lost_job&lt;br&gt;This is the reconciliation, on demand, no cron" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="ctApi">
          <mxGeometry x="280" y="400" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="B7" value="Insert AnalysisRun (status = queued, job_description_hash, profile_version)&lt;br&gt;Insert 3 AnalysisAgent rows (status = pending)&lt;br&gt;Partial unique index on (candidate_id) where status in (queued, running) rejects a concurrent second insert → mapped to 409" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="ctApi">
          <mxGeometry x="20" y="480" width="330" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="B8" value="Enqueue agents-job&lt;br&gt;jobId = candidate:&amp;lt;id&amp;gt; (queue dedup)&lt;br&gt;data = { runId }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="ctApi">
          <mxGeometry x="370" y="480" width="150" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="B9" value="202 Accepted { runId }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="ctApi">
          <mxGeometry x="20" y="575" width="330" height="30" as="geometry"/>
        </mxCell>

        <!-- ===================== REDIS / BULLMQ ===================== -->
        <mxCell id="ctQueue" value="Redis · BullMQ (ADR-0020)" style="swimlane;html=1;fontStyle=1;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1060" y="60" width="320" height="270" as="geometry"/>
        </mxCell>
        <mxCell id="C1" value="Queue: agents-job&lt;br&gt;one job per AnalysisRun" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="ctQueue">
          <mxGeometry x="20" y="40" width="280" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="C2" value="Native, not hand-written:&lt;br&gt;· attempts + exponential backoff&lt;br&gt;· stalled job detection (dead worker → job returns to wait)&lt;br&gt;· jobId dedup (double click protection)&lt;br&gt;· limiter for the LLM provider rate limit&lt;br&gt;Redis is the mechanism; PostgreSQL is the truth" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="ctQueue">
          <mxGeometry x="20" y="105" width="280" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="C3" value="Job removed on complete; run state lives in the DB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="ctQueue">
          <mxGeometry x="20" y="225" width="280" height="30" as="geometry"/>
        </mxCell>

        <!-- ===================== WORKER ===================== -->
        <mxCell id="ctWorker" value="Worker (apps/worker) · AgentsRunner processor" style="swimlane;html=1;fontStyle=1;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1060" y="360" width="320" height="320" as="geometry"/>
        </mxCell>
        <mxCell id="D1" value="Load AnalysisRun + AnalysisAgent rows by runId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="ctWorker">
          <mxGeometry x="20" y="40" width="280" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="D2" value="status = running, heartbeat_at = now (lease start)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="ctWorker">
          <mxGeometry x="20" y="95" width="280" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="D3" value="For each Agent in fixed order:&lt;br&gt;content_recommendation → ats → resume_recommendation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="ctWorker">
          <mxGeometry x="20" y="150" width="280" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="D4" value="Checkpoint:&lt;br&gt;Agent already completed or skipped?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="ctWorker">
          <mxGeometry x="50" y="210" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="D5" value="No Agent left → AnalysisRun completed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="ctWorker">
          <mxGeometry x="20" y="280" width="280" height="30" as="geometry"/>
        </mxCell>

        <!-- ===================== AGENT CYCLE ===================== -->
        <mxCell id="ctCycle" value="Agent execution cycle (same for every Agent)" style="swimlane;html=1;fontStyle=1;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="720" width="920" height="560" as="geometry"/>
        </mxCell>
        <mxCell id="E1" value="Exact cache lookup in agent_cache&lt;br&gt;key = candidate_id + job_description_hash + profile_version + agent&lt;br&gt;No similarity search in the MVP; a changed Profile invalidates the entry by construction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="ctCycle">
          <mxGeometry x="20" y="45" width="320" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="E2" value="Exact hit?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="ctCycle">
          <mxGeometry x="100" y="135" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="E3" value="Persist AnalysisAgent&lt;br&gt;status = completed, source = cache, output = cached JSON&lt;br&gt;heartbeat_at = now · no LLM call · still a visible Step" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="ctCycle">
          <mxGeometry x="380" y="130" width="280" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="E4" value="RAG (TC-07): build the query for THIS Agent (Job Description requirements, previous Agent output), embed it, similarity search on profile_segment (pgvector), keep top-k Segments&lt;br&gt;The full Profile never reaches the prompt (ADR-0009)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="ctCycle">
          <mxGeometry x="20" y="225" width="320" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="E5" value="LangChain call&lt;br&gt;prompt = Job Description + retrieved Segments + previous Agent output&lt;br&gt;Structured output bound to the Agent's Zod schema (packages/shared)&lt;br&gt;LLM provider: pending ADR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="ctCycle">
          <mxGeometry x="20" y="335" width="320" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="E6" value="Response parses against the Zod schema?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="ctCycle">
          <mxGeometry x="80" y="450" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="E7" value="Persist AnalysisAgent&lt;br&gt;status = completed, source = llm, output = JSON&lt;br&gt;heartbeat_at = now&lt;br&gt;Write agent_cache entry for the same key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="ctCycle">
          <mxGeometry x="380" y="340" width="280" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="E8" value="Persist failure on the Agent row&lt;br&gt;status = failed, attempts + 1, failure_reason (timeout · rate_limit · invalid_response · provider_error)&lt;br&gt;Throw → BullMQ retries the job; the checkpoint makes it resume at this Agent, never from zero" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="ctCycle">
          <mxGeometry x="380" y="445" width="280" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="E9" value="Attempts exhausted&lt;br&gt;AnalysisRun status = failed, failure_reason copied from the Agent&lt;br&gt;Candidate sees which Step stopped and why" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="ctCycle">
          <mxGeometry x="690" y="445" width="210" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="E10" value="Next Agent (back to the checkpoint loop)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="ctCycle">
          <mxGeometry x="690" y="240" width="210" height="60" as="geometry"/>
        </mxCell>

        <!-- ===================== AGENTS CHAIN ===================== -->
        <mxCell id="ctAgents" value="Agents, strictly in sequence (TC-06) · each reads what the previous one persisted" style="swimlane;html=1;fontStyle=1;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="720" width="380" height="560" as="geometry"/>
        </mxCell>
        <mxCell id="F1" value="&lt;b&gt;1. Content Recommendation&lt;/b&gt;&lt;br&gt;LLM extracts the Job Description requirements and finds evidence in the Profile&lt;br&gt;output: requirements[] { text, kind (skill · experience · education · certification · language), required, evidence[] { segmentId, confidence 0..1 } }, gaps[] { requirementIndex, reason }" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="ctAgents">
          <mxGeometry x="20" y="40" width="340" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="F2" value="&lt;b&gt;2. ATS&lt;/b&gt;&lt;br&gt;input: requirements + evidence from Agent 1&lt;br&gt;LLM judges: title_match, relevance&lt;br&gt;Code computes: hard_skills, soft_skills, experience_years, education&lt;br&gt;score 0..10 = weighted sum, calculated in code (weights are system config, reproducible, unit-testable)&lt;br&gt;output: score, criteria[] { name, weight, score, evidence[], justification }&lt;br&gt;Parseability of the Uploaded Resume: out of the MVP" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="ctAgents">
          <mxGeometry x="20" y="180" width="340" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="F3" value="score &amp;lt; 8 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="ctAgents">
          <mxGeometry x="40" y="360" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="F5" value="Agent 3 status = skipped&lt;br&gt;run still completes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="ctAgents">
          <mxGeometry x="220" y="365" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="F4" value="&lt;b&gt;3. Resume Recommendations&lt;/b&gt; (rebuild)&lt;br&gt;input: ATS score + criteria, gaps from Agent 1&lt;br&gt;output: basedOnAtsScore, changes[] { target (summary · experience · skill · project · education), targetId?, action (rewrite · add · remove · reorder), before?, after, addressesGapIndex? }" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="ctAgents">
          <mxGeometry x="20" y="440" width="340" height="105" as="geometry"/>
        </mxCell>

        <!-- ===================== POSTGRES ===================== -->
        <mxCell id="ctDb" value="PostgreSQL + pgvector (ADR-0012 Kysely, migrations)" style="swimlane;html=1;fontStyle=1;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="1320" width="1340" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="G1" value="&lt;b&gt;analysis_run&lt;/b&gt;&lt;br&gt;id · candidate_id · job_description · job_description_hash · profile_version · status (queued · running · completed · failed) · heartbeat_at · failure_reason · created_at · completed_at&lt;br&gt;&lt;br&gt;unique partial index (candidate_id) where status in (queued, running) → TC-05" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="ctDb">
          <mxGeometry x="20" y="40" width="320" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="G2" value="&lt;b&gt;analysis_agent&lt;/b&gt;&lt;br&gt;id · run_id · agent (content_recommendation · ats · resume_recommendation) · position · status (pending · running · completed · failed · skipped) · attempts · source (llm · cache) · output jsonb · failure_reason · started_at · finished_at&lt;br&gt;&lt;br&gt;unique (run_id, agent) → idempotency key of the checkpoint" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="ctDb">
          <mxGeometry x="360" y="40" width="320" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="G3" value="&lt;b&gt;agent_cache&lt;/b&gt;&lt;br&gt;candidate_id · job_description_hash · profile_version · agent · output jsonb · created_at&lt;br&gt;&lt;br&gt;unique (candidate_id, job_description_hash, profile_version, agent)&lt;br&gt;No embedding column: the key is a hash, the value is the JSON" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="ctDb">
          <mxGeometry x="700" y="40" width="320" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="G4" value="&lt;b&gt;profile_segment&lt;/b&gt; (already produced by Ingestion, TC-03)&lt;br&gt;id · profile_id · kind · text · embedding vector · metadata jsonb&lt;br&gt;&lt;br&gt;Read-only for this pipeline; profile_version bumps whenever the Profile changes, which invalidates agent_cache" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="ctDb">
          <mxGeometry x="1040" y="40" width="280" height="160" as="geometry"/>
        </mxCell>

        <!-- ===================== SHARED ===================== -->
        <mxCell id="ctShared" value="packages/shared (Zod, ADR-0011)" style="swimlane;html=1;fontStyle=1;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1420" y="60" width="260" height="270" as="geometry"/>
        </mxCell>
        <mxCell id="H1" value="startAnalysisRequestSchema&lt;br&gt;analysisRunSchema (run + agents status for the UI)&lt;br&gt;contentRecommendationSchema&lt;br&gt;atsResultSchema&lt;br&gt;resumeRecommendationSchema&lt;br&gt;&lt;br&gt;Each exports its inferred type; apps/web, apps/api and apps/worker never hand-write these types" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="ctShared">
          <mxGeometry x="20" y="40" width="220" height="210" as="geometry"/>
        </mxCell>

        <!-- ===================== NOTES ===================== -->
        <mxCell id="N1" value="&lt;b&gt;State machines&lt;/b&gt;&lt;br&gt;AnalysisRun: queued → running → completed | failed&lt;br&gt;AnalysisAgent: pending → running → completed | failed | skipped&lt;br&gt;run completed = every Agent completed or skipped&lt;br&gt;run failed = one Agent exhausted attempts, or lost_job" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1420" y="360" width="260" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="N2" value="&lt;b&gt;Concurrency&lt;/b&gt;&lt;br&gt;Lease is per Candidate; N Candidates = N independent runs&lt;br&gt;Same Candidate, two requests: partial unique index decides, jobId dedup is the second barrier&lt;br&gt;Worker concurrency N = N simultaneous LLM calls → BullMQ limiter" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1420" y="500" width="260" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="N3" value="&lt;b&gt;Pending decisions (docs/adr/README.md)&lt;/b&gt;&lt;br&gt;LLM provider behind LangChain&lt;br&gt;Deployment target with its Redis and object store&lt;br&gt;&lt;br&gt;&lt;b&gt;To be written&lt;/b&gt;&lt;br&gt;ADR: run state machine, checkpoints, lease, exact cache (follow-up of ADR-0009)&lt;br&gt;CONTEXT.md: Agent" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1420" y="640" width="260" height="140" as="geometry"/>
        </mxCell>

        <!-- ===================== LEGEND ===================== -->
        <mxCell id="ctLegend" value="Legend" style="swimlane;html=1;fontStyle=1;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1420" y="800" width="260" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="L1" value="Process" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="ctLegend">
          <mxGeometry x="20" y="40" width="220" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="L2" value="Decision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="ctLegend">
          <mxGeometry x="20" y="80" width="220" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="L3" value="Agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="ctLegend">
          <mxGeometry x="20" y="120" width="220" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="L4" value="Persist / data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="ctLegend">
          <mxGeometry x="20" y="160" width="220" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="L5" value="Failure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="ctLegend">
          <mxGeometry x="20" y="200" width="220" height="30" as="geometry"/>
        </mxCell>

        <!-- ===================== EDGES: frontend / api ===================== -->
        <mxCell id="eA1A2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="A1" target="A2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eA2B1" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="A2" target="B1"><mxGeometry relative="1" as="geometry"/></mxCell>
