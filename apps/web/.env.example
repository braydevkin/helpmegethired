# Origin of the API when the web app runs natively; the compose stack sets http://api:3001
API_URL=http://localhost:3001

# PostgreSQL connection the Auth.js adapter uses for Accounts, Sessions, and verification tokens
DATABASE_URL=postgresql://helpmegethired:helpmegethired@localhost:5432/helpmegethired

# Secret that signs the Auth.js cookies; at least 32 characters, unique per environment
AUTH_SECRET=development-only-secret-replace-me-before-deploying

# Resend API key for the one-time code email; leave blank and the code is printed instead of sent
AUTH_RESEND_KEY=
# Sender of the one-time code email, on a domain verified in Resend; required whenever AUTH_RESEND_KEY is set
EMAIL_FROM=
