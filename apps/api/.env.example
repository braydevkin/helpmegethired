# Runtime mode: development, test or production
NODE_ENV=development

# TCP port the API listens on
PORT=3001

# Origin of the web app allowed by CORS
WEB_ORIGIN=http://localhost:3000

# Redis that holds the BullMQ queues; the compose service publishes it on REDIS_PORT
REDIS_URL=redis://localhost:6379

# Jobs the worker process runs at the same time
WORKER_CONCURRENCY=4

# Milliseconds the worker gives pdftotext for one file before killing it
EXTRACTION_TIMEOUT_MS=30000

# Minutes a record may stay processing without an active job before the reconciliation job resets it
STALE_PROCESSING_MINUTES=10

# Object store for a native run: the compose storage service through its host ports
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=resumes
S3_ACCESS_KEY=helpmegethired
S3_SECRET_KEY=helpmegethired-storage
S3_REGION=us-east-1
PRESIGN_EXPIRES_SECONDS=300

# Blank selects the development stand-ins for the Model Key check and its encryption; production needs
# MODEL_ADAPTER=anthropic and a MODEL_KEY_ENCRYPTION_KEY of 32 random bytes in base64 (openssl rand -base64 32).
MODEL_ADAPTER=
MODEL_KEY_ENCRYPTION_KEY=
